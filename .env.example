# ============================================================================
# PostgreSQL MCP Server - Environment Configuration
# ============================================================================
# Copy this file to .env and configure with your actual values
# DO NOT commit .env to version control
# ============================================================================

# Database connection (shared by all databases listed in DATABASE_NAMES)
DATABASE_HOST=159.75.33.167
DATABASE_PORT=5432
DATABASE_NAME=blog_small
DATABASE_USER=root
DATABASE_PASSWORD=123456
DATABASE_MIN_POOL_SIZE=5
DATABASE_MAX_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=30
DATABASE_COMMAND_TIMEOUT=30

# Multi-database: comma-separated DB names sharing host/user/password/pool settings
# Leave empty to use only DATABASE_NAME
DATABASE_NAMES=blog_small,ecommerce_medium,saas_crm_large,hr_system,hospital_care,security_ops

# DeepSeek (OpenAI-compatible) — or set OPENAI_BASE_URL to https://api.openai.com/v1
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.0
OPENAI_TIMEOUT=60

# Security
SECURITY_ALLOW_WRITE_OPERATIONS=false
SECURITY_BLOCKED_FUNCTIONS=pg_sleep,pg_read_file,pg_write_file,lo_import,lo_export
SECURITY_BLOCKED_TABLES=user_sessions,api_keys
SECURITY_BLOCKED_COLUMNS=users.password_hash
SECURITY_ALLOW_EXPLAIN=false
SECURITY_MAX_ROWS=10000
SECURITY_MAX_EXECUTION_TIME=30

# Validation
VALIDATION_MAX_QUESTION_LENGTH=10000
VALIDATION_MIN_CONFIDENCE_SCORE=70
VALIDATION_SAMPLE_ROWS=5
VALIDATION_TIMEOUT_SECONDS=10
VALIDATION_ENABLED=true

# Cache
CACHE_ENABLED=true
CACHE_SCHEMA_TTL=3600
CACHE_MAX_SIZE=100

# Resilience
RESILIENCE_MAX_RETRIES=3
RESILIENCE_RETRY_DELAY=0.1
RESILIENCE_BACKOFF_FACTOR=2.0
RESILIENCE_CIRCUIT_BREAKER_THRESHOLD=5
RESILIENCE_CIRCUIT_BREAKER_TIMEOUT=60
RESILIENCE_MAX_CONCURRENT_QUERIES=10
RESILIENCE_MAX_CONCURRENT_LLM=5
RESILIENCE_RATE_LIMIT_TIMEOUT=30

# Observability
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_METRICS_PORT=9090
OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_LOG_FORMAT=text

ENVIRONMENT=development
